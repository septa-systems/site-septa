---
import Logo from "./Logo.astro";
import { MENU } from "../config/site";
---

<header class="topo">
  <div class="container topo__linha">
    <a href="/" aria-label="Septa Systems, início">
      <Logo />
    </a>
    <nav aria-label="Menu principal">
      <ul class="topo__menu">
        {MENU.map((item) => (
          <li>
            <a href={item.href}>{item.texto}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: rgba(1, 8, 10, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cor-borda);
  }

  .topo__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    height: 4.25rem;
  }

  .topo__menu {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--cor-texto-suave);
  }

  .topo__menu a {
    transition: color 0.15s ease;
  }

  .topo__menu a:hover {
    color: var(--cor-texto);
  }

  @media (max-width: 860px) {
    .topo nav {
      display: none;
    }
  }
</style>

---
// Painel de sistema de exemplo (dados fictícios). Parado nesta versão;
// a animação (endireitar ao rolar, números e barras) entra na issue #5.
import Simbolo from "./Simbolo.astro";
---

<section id="sistemas" class="secao vitrine">
  <div class="container">
    <div class="vit-head">
      <div class="vit-txt">
        <span class="eyebrow">Sistemas sob medida</span>
        <h2>Seu negócio inteiro numa tela só</h2>
        <p class="lead">
          Agenda, clientes, mensagens e o dinheiro do mês no mesmo lugar, no celular ou no
          computador. E o que é repetido, o sistema faz sozinho.
        </p>
      </div>
      <ul class="checks">
        <li>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12.5l4.5 4.5L19 7" />
          </svg>
          Lembrete automático no WhatsApp do cliente
        </li>
        <li>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12.5l4.5 4.5L19 7" />
          </svg>
          Cadastro de clientes com histórico de atendimentos
        </li>
        <li>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12.5l4.5 4.5L19 7" />
          </svg>
          Painel com o que entrou no dia, na semana e no mês
        </li>
      </ul>
    </div>

    <div class="palco" id="palco" aria-hidden="true">
      <div class="cena" id="cena">
        <div class="dash">
          <aside class="d-side">
            <div class="d-marca">
              <Simbolo />
              SEU NEGÓCIO
            </div>
            <span class="d-item on">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
              </svg>
              Visão geral
            </span>
            <span class="d-item">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <rect x="3" y="5" width="18" height="16" rx="2.5" />
                <path d="M3 10h18M8 3v4M16 3v4" />
              </svg>
              Agenda
            </span>
            <span class="d-item">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="9" cy="8" r="3.5" />
                <path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2.2.5 3.5 2.6 3.5 6" />
              </svg>
              Clientes
            </span>
            <span class="d-item">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" />
              </svg>
              Mensagens<span class="badge">3</span>
            </span>
            <span class="d-item">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <path d="M5 20V12M12 20V5M19 20v-9" />
              </svg>
              Financeiro
            </span>
            <span class="d-item">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              >
                <circle cx="12" cy="12" r="3" />
                <path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
              </svg>
              Configurações
            </span>
            <div class="d-plano">
              <b>Feito pela Septa</b>Suporte no WhatsApp
            </div>
          </aside>

          <div class="d-main">
            <div class="d-top">
              <div>
                <span class="oi">Bom dia, Ana</span>
                <small>Terça, 24 de novembro</small>
              </div>
              <span class="d-busca">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <circle cx="11" cy="11" r="7" />
                  <path d="M20 20l-3.5-3.5" />
                </svg>
                Buscar cliente
              </span>
              <span class="d-novo">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
                Novo agendamento
              </span>
            </div>

            <div class="kpis">
              <div class="kpi">
                <span class="l">Agendamentos hoje</span>
                <span class="n" data-n="18">
                  18
                </span>
                <span class="d">+12% que terça passada</span>
                <svg viewBox="0 0 100 34" preserveAspectRatio="none">
                  <path
                    d="M0 26 L17 22 L33 24 L50 15 L67 18 L83 10 L100 6"
                    fill="none"
                    stroke="#2DD4BF"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
              <div class="kpi">
                <span class="l">Faturamento do mês</span>
                <span class="n" data-n="14380" data-pre="R$ ">
                  R$ 14.380
                </span>
                <span class="d">+8% que outubro</span>
                <svg viewBox="0 0 100 34" preserveAspectRatio="none">
                  <path
                    d="M0 28 L17 25 L33 20 L50 22 L67 14 L83 12 L100 8"
                    fill="none"
                    stroke="#38BDF8"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
              <div class="kpi">
                <span class="l">Clientes ativos</span>
                <span class="n" data-n="312">
                  312
                </span>
                <span class="d">+21 novos no mês</span>
                <svg viewBox="0 0 100 34" preserveAspectRatio="none">
                  <path
                    d="M0 24 L17 23 L33 21 L50 19 L67 16 L83 13 L100 10"
                    fill="none"
                    stroke="#2DD4BF"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
              <div class="kpi">
                <span class="l">Confirmaram presença</span>
                <span class="n" data-n="94" data-pos="%">
                  94%
                </span>
                <span class="d">com lembrete automático</span>
                <svg viewBox="0 0 100 34" preserveAspectRatio="none">
                  <path
                    d="M0 18 L17 14 L33 16 L50 10 L67 12 L83 8 L100 7"
                    fill="none"
                    stroke="#38BDF8"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
            </div>

            <div class="d-linha">
              <div class="painel">
                <div class="t">
                  Atendimentos nos últimos 7 dias <span>124 no total</span>
                </div>
                <div class="barras">
                  <div class="barra" style="--h:43%;--i:0">
                    <b>16</b>
                    <i></i>
                    <span>Qua</span>
                  </div>
                  <div class="barra" style="--h:57%;--i:1">
                    <b>21</b>
                    <i></i>
                    <span>Qui</span>
                  </div>
                  <div class="barra" style="--h:70%;--i:2">
                    <b>26</b>
                    <i></i>
                    <span>Sex</span>
                  </div>
                  <div class="barra" style="--h:62%;--i:3">
                    <b>23</b>
                    <i></i>
                    <span>Sáb</span>
                  </div>
                  <div class="barra" style="--h:16%;--i:4">
                    <b>6</b>
                    <i></i>
                    <span>Dom</span>
                  </div>
                  <div class="barra" style="--h:38%;--i:5">
                    <b>14</b>
                    <i></i>
                    <span>Seg</span>
                  </div>
                  <div class="barra hoje" style="--h:48%;--i:6">
                    <b>18</b>
                    <i></i>
                    <span>Hoje</span>
                  </div>
                </div>
              </div>
              <div class="painel">
                <div class="t">
                  De onde vêm os clientes <span>novembro</span>
                </div>
                <div class="rosca">
                  <svg viewBox="0 0 120 120">
                    <circle
                      cx="60"
                      cy="60"
                      r="46"
                      fill="none"
                      stroke="rgba(255,255,255,.06)"
                      stroke-width="14"
                    />
                    <g transform="rotate(-90 60 60)" fill="none" stroke-width="14">
                      <circle
                        class="arco"
                        cx="60"
                        cy="60"
                        r="46"
                        stroke="#2DD4BF"
                        stroke-dasharray="118.4 289"
                        stroke-dashoffset="0"
                      />
                      <circle
                        class="arco"
                        cx="60"
                        cy="60"
                        r="46"
                        stroke="#38BDF8"
                        stroke-dasharray="98.2 289"
                        stroke-dashoffset="-121.4"
                      />
                      <circle
                        class="arco"
                        cx="60"
                        cy="60"
                        r="46"
                        stroke="#A7F3D0"
                        stroke-dasharray="63.5 289"
                        stroke-dashoffset="-222.6"
                      />
                    </g>
                    <text
                      x="60"
                      y="58"
                      text-anchor="middle"
                      fill="#F5F5F5"
                      font-size="20"
                      font-weight="700"
                      font-family="Manrope Variable, sans-serif"
                    >
                      21
                    </text>
                    <text
                      x="60"
                      y="75"
                      text-anchor="middle"
                      fill="#A3A8A8"
                      font-size="10"
                      font-family="Inter, sans-serif"
                    >
                      novos
                    </text>
                  </svg>
                  <div class="legenda">
                    <span>
                      <i style="background:#2DD4BF"></i>Site<b>42%</b>
                    </span>
                    <span>
                      <i style="background:#38BDF8"></i>WhatsApp<b>35%</b>
                    </span>
                    <span>
                      <i style="background:#A7F3D0"></i>Indicação<b>23%</b>
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-linha">
              <div class="painel">
                <div class="t">
                  Próximos horários <span>hoje</span>
                </div>
                <div>
                  <div class="hor">
                    <span class="h">14:30</span>
                    <span class="q">
                      <b>Carla Mendes</b>
                      <span>Corte e escova</span>
                    </span>
                    <span class="pill ok">Confirmado</span>
                  </div>
                  <div class="hor">
                    <span class="h">15:15</span>
                    <span class="q">
                      <b>Rafael Souza</b>
                      <span>Avaliação</span>
                    </span>
                    <span class="pill esp">Aguardando</span>
                  </div>
                  <div class="hor">
                    <span class="h">16:00</span>
                    <span class="q">
                      <b>Juliana Prado</b>
                      <span>Retorno</span>
                    </span>
                    <span class="pill novo">Novo pelo site</span>
                  </div>
                </div>
              </div>
              <div class="painel">
                <div class="t">
                  Mensagens automáticas <span>WhatsApp</span>
                </div>
                <div class="msg">
                  <span class="av">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                  </span>
                  <p>
                    Lembrete enviado para Carla<time>09:12</time>
                  </p>
                </div>
                <div class="msg">
                  <span class="av">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                  </span>
                  <p>
                    Rafael respondeu: "Confirmo, até mais tarde!"<time>10:40</time>
                  </p>
                </div>
                <div class="msg">
                  <span class="av">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12.5l4.5 4.5L19 7" />
                    </svg>
                  </span>
                  <p>
                    Pedido de avaliação enviado para 6 clientes<time>11:05</time>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="chip c1">
          <div class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <rect x="3" y="5" width="18" height="16" rx="2.5" />
              <path d="M3 10h18M8 3v4M16 3v4" />
            </svg>
          </div>
          <div>
            <b>Novo agendamento</b>Hoje, 16:00
          </div>
        </div>
        <div class="chip c2">
          <div class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.4A8.4 8.4 0 1 1 21 11.5z" />
            </svg>
          </div>
          <div>
            <b>Lembrete enviado</b>WhatsApp, 1 dia antes
          </div>
        </div>
        <div class="chip c3">
          <div class="ic">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12.5l4.5 4.5L19 7" />
            </svg>
          </div>
          <div>
            <b>Cliente confirmou</b>agora há pouco
          </div>
        </div>
      </div>
    </div>
    <p class="exemplo">
      Painel de exemplo, com dados fictícios. Cada sistema é feito do jeito do seu negócio.
    </p>
  </div>
</section>

<script>
  import { iniciaPainel } from "../scripts/painel";
  const sec = document.getElementById("sistemas");
  const palco = document.getElementById("palco");
  const cena = document.getElementById("cena");
  if (sec && palco && cena) iniciaPainel(sec, palco, cena);
</script>

<style>
  /* ===== painel do sistema (dashboard de exemplo) ===== */
  .vitrine::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 55% 45% at 50% 65%,
      rgba(45, 212, 191, 0.14),
      transparent 70%
    );
  }
  .vit-head {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 24px 56px;
    align-items: end;
  }
  @media (max-width: 920px) {
    .vit-head {
      grid-template-columns: 1fr;
    }
  }
  .vit-txt {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .checks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: #d3d8d8;
  }
  .checks svg {
    flex: none;
    margin-top: 3px;
    color: var(--cor-destaque);
  }
  .palco {
    position: relative;
    perspective: 1800px;
    padding-block: 56px 20px;
    min-width: 0;
  }
  .cena {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 10deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.12s linear;
  }
  .exemplo {
    position: relative;
    text-align: center;
    font-size: 12.5px;
    color: var(--cor-texto-suave);
    margin-top: 28px;
  }

  .dash {
    display: grid;
    grid-template-columns: 200px 1fr;
    background: #061012;
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    overflow: hidden;
    font-size: 13px;
    box-shadow:
      0 60px 120px rgba(0, 0, 0, 0.8),
      0 0 110px rgba(45, 212, 191, 0.16);
  }
  .d-side {
    border-right: 1px solid var(--cor-borda);
    padding: 18px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: rgba(255, 255, 255, 0.015);
  }
  .d-marca {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 10px 18px;
    font-family: var(--fonte-logo);
    font-weight: 600;
    letter-spacing: 0.07em;
    color: #e6f2f0;
  }
  .d-marca :global(svg) {
    width: 22px;
    height: 22px;
  }
  .d-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border-radius: 10px;
    color: var(--cor-texto-suave);
  }
  .d-item svg {
    flex: none;
  }
  .d-item.on {
    background: var(--cor-destaque-suave);
    color: var(--cor-texto);
  }
  .d-item.on svg {
    color: var(--cor-destaque);
  }
  .d-item .badge {
    margin-left: auto;
    background: var(--cor-destaque);
    color: var(--cor-destaque-texto);
    font-size: 11px;
    font-weight: 700;
    padding: 0 7px;
    border-radius: 99px;
    line-height: 18px;
  }
  .d-plano {
    margin-top: auto;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--cor-destaque-linha);
    background: linear-gradient(160deg, rgba(45, 212, 191, 0.14), transparent);
    font-size: 12px;
    color: var(--cor-texto-suave);
  }
  .d-plano b {
    display: block;
    color: var(--cor-texto);
    font-size: 13px;
  }
  .d-main {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .d-top {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .d-top .oi {
    font-family: var(--fonte-titulo);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
  }
  .d-top small {
    color: var(--cor-texto-suave);
    display: block;
    font-size: 12.5px;
  }
  .d-busca {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--cor-borda);
    color: var(--cor-texto-suave);
    min-width: 170px;
  }
  .d-novo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--cor-destaque);
    color: var(--cor-destaque-texto);
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 10px;
    white-space: nowrap;
  }
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .kpi {
    border: 1px solid var(--cor-borda);
    border-radius: 14px;
    padding: 14px 14px 10px;
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .kpi .l {
    color: var(--cor-texto-suave);
    font-size: 12px;
  }
  .kpi .n {
    font-family: var(--fonte-titulo);
    font-size: 26px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .kpi .d {
    font-size: 12px;
    color: #4ade80;
  }
  .kpi svg {
    width: 100%;
    height: 34px;
    display: block;
    margin-top: 4px;
    overflow: visible;
  }
  .d-linha {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 12px;
  }
  .painel {
    border: 1px solid var(--cor-borda);
    border-radius: 14px;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.025);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .painel .t {
    font-size: 13.5px;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .painel .t span {
    font-weight: 400;
    color: var(--cor-texto-suave);
    font-size: 12px;
  }
  .barras {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;

---
import Icone from "./Icone.astro";
import Pendente from "./Pendente.astro";
import { SITE, SERVICOS_CONTATO } from "../config/site";
---

<section id="contato" class="secao">
  <div class="container">
    <div class="contato">
      <div class="contato__canais">
        <span class="chamada">Contato</span>
        <h2>Vamos conversar sobre o seu negócio?</h2>
        <div class="canais">
          <div class="canal">
            <div class="canal__icone">
              <Icone nome="whatsapp" tamanho={20} />
            </div>
            <div>
              <span>WhatsApp</span>
              <b>
                <Pendente valor={SITE.whatsappVisivel} />
              </b>
            </div>
          </div>
          <div class="canal">
            <div class="canal__icone">
              <Icone nome="email" tamanho={20} />
            </div>
            <div>
              <span>E-mail</span>
              <b>{SITE.email}</b>
            </div>
          </div>
          <a
            class="canal"
            href={`https://instagram.com/${SITE.instagram}`}
            target="_blank"
            rel="noopener"
          >
            <div class="canal__icone">
              <Icone nome="instagram" tamanho={20} />
            </div>
            <div>
              <span>Instagram</span>
              <b>@{SITE.instagram}</b>
            </div>
          </a>
        </div>
      </div>

      <!-- Não envia nada para servidor: monta a mensagem e abre o WhatsApp (PRD, CT04 e CT05). -->
      <form class="formulario" id="form-contato" data-whatsapp={SITE.whatsapp} novalidate>
        <div class="campo">
          <label for="c-nome">Seu nome</label>
          <input id="c-nome" name="nome" type="text" autocomplete="name" required maxlength="80" />
        </div>
        <div class="campo">
          <label for="c-servico">O que você precisa?</label>
          <select id="c-servico" name="servico">
            {SERVICOS_CONTATO.map((s) => (
              <option>{s}</option>
            ))}
          </select>
        </div>
        <div class="campo">
          <label for="c-msg">Conta um pouco do seu negócio</label>
          <textarea id="c-msg" name="mensagem" required maxlength="600"></textarea>
        </div>
        <button class="botao botao--principal" type="submit">
          <Icone nome="whatsapp" tamanho={20} />
          Enviar pelo WhatsApp
        </button>
        <p class="formulario__aviso" id="contato-aviso" role="status" hidden></p>
        <p class="formulario__nota">
          Abre o seu WhatsApp com a mensagem pronta. A gente não guarda nada por aqui.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("form-contato") as HTMLFormElement;
  const aviso = document.getElementById("contato-aviso") as HTMLParagraphElement;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const dados = new FormData(form);
    const nome = String(dados.get("nome") ?? "").trim();
    const servico = String(dados.get("servico") ?? "").trim();
    const mensagem = String(dados.get("mensagem") ?? "").trim();

    const vazio = !nome ? "c-nome" : !mensagem ? "c-msg" : "";
    if (vazio) {
      aviso.textContent = !nome ? "Escreva o seu nome." : "Conta um pouco do seu negócio.";
      aviso.hidden = false;
      document.getElementById(vazio)?.focus();
      return;
    }

    const numero = form.dataset.whatsapp ?? "";
    if (!/^\d{12,13}$/.test(numero)) {
      aviso.textContent = "O WhatsApp da Septa ainda não foi definido neste rascunho.";
      aviso.hidden = false;
      return;
    }

    aviso.hidden = true;
    const texto = `Olá! Vim pelo site. Sou ${nome} e preciso de: ${servico}.\n\n${mensagem}`;
    window.open(`https://wa.me/${numero}?text=${encodeURIComponent(texto)}`, "_blank", "noopener");
  });
</script>

<style>
  .contato {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    padding: 3rem;
    border-radius: 26px;
    border: 1px solid var(--cor-borda);
    background: var(--cor-superficie);
  }

  .contato::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 50% 70% at 0% 100%,
      rgba(45, 212, 191, 0.18),
      transparent 70%
    );
  }

  .contato > * {
    position: relative;
    min-width: 0;
  }

  h2 {
    margin-top: 0.75rem;
  }

  .canais {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .canal {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--cor-borda);
    background: rgba(0, 0, 0, 0.35);
  }

  a.canal:hover {
    border-color: var(--cor-destaque-linha);
  }

  .canal__icone {
    width: 40px;
    height: 40px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--cor-destaque-suave);
    color: var(--cor-destaque);
  }

  .canal span {
    display: block;
    font-size: 0.8125rem;
    color: var(--cor-texto-suave);
  }

  .canal b {
    font-weight: 600;
    overflow-wrap: anywhere;
    user-select: all;
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  label {
    font-size: 0.875rem;
    color: var(--cor-texto-suave);
  }

  input,
  select,
  textarea {
    min-width: 0;
    padding: 0.75rem 0.875rem;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    background: rgba(0, 0, 0, 0.45);
    color: var(--cor-texto);
    font: inherit;
    font-size: 0.9375rem;
  }

  textarea {
    min-height: 6rem;
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--cor-destaque);
    outline: none;
  }

  .formulario .botao {
    align-self: flex-start;
  }

  .formulario__aviso {
    font-size: 0.875rem;
    color: var(--cor-alerta);
  }

  .formulario__nota {
    font-size: 0.8125rem;
    color: var(--cor-texto-suave);
  }

  @media (max-width: 860px) {
    .contato {
      grid-template-columns: 1fr;
      padding: 1.75rem;
    }
  }
</style>
